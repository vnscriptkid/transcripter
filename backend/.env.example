# OpenAI API Key (required for Whisper API)
OPENAI_API_KEY=your-api-key-here

# Development: Use mock transcription service to avoid API costs during local development
# Set to true to use mock service (no API calls), false to use real OpenAI API
USE_MOCK_TRANSCRIPTION=false

# Google OAuth (required for authentication)
# Get this from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Secret Key (REQUIRED in production - use a strong random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production

# JWT token expiration in hours (default 168 = 7 days)
JWT_EXPIRATION_HOURS=168
