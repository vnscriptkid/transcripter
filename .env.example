# Backend Environment Variables
OPENAI_API_KEY=your_openai_api_key_here

# Development: Use mock transcription service to avoid API costs during local development
# Set to true to use mock service (no API calls), false to use real OpenAI API
USE_MOCK_TRANSCRIPTION=false

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# Frontend Environment Variables
# Set this to your backend API URL in production
VITE_API_URL=http://localhost:8000

# For Docker Compose
# VITE_API_URL=http://backend:8000
